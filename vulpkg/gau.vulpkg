{
  "name": "gau",
  "version": "latest",
  "description": "Fetch known URLs from Wayback/OTX/CommonCrawl",
  "author": "upstream",
  "requires_sudo": true,
  "alpine_packages": [
    "go"
  ],
  "install_script": "export GOROOT=/usr/lib/go GOBIN=/usr/local/bin GOPATH=/opt/vulpkg/.go GOFLAGS=-mod=mod GOTOOLCHAIN=auto\ngo install github.com/lc/gau/v2/cmd/gau@latest"
}