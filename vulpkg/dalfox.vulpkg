{
  "name": "dalfox",
  "version": "latest",
  "description": "Parameter analysis and XSS scanner",
  "author": "upstream",
  "requires_sudo": true,
  "alpine_packages": [
    "go"
  ],
  "install_script": "export GOROOT=/usr/lib/go GOBIN=/usr/local/bin GOPATH=/opt/vulpkg/.go GOFLAGS=-mod=mod GOTOOLCHAIN=auto\ngo install github.com/hahwul/dalfox/v2@latest"
}