{
  "name": "dirsearch",
  "version": "latest",
  "description": "dirsearch - modern web path/content brute-forcer",
  "author": "maurosoria",
  "requires_sudo": true,
  "alpine_packages": [
    "git",
    "python3",
    "py3-pip",
    "py3-virtualenv"
  ],
  "install_script": "git clone --depth 1 https://github.com/maurosoria/dirsearch.git src\npython3 -m venv src/venv || virtualenv src/venv\nsrc/venv/bin/pip install --upgrade pip wheel\nsrc/venv/bin/pip install -r src/requirements.txt\nprintf '#!/bin/sh\\nexec /opt/vulpkg/dirsearch/src/venv/bin/python3 /opt/vulpkg/dirsearch/src/dirsearch.py \"$@\"\\n' > /usr/local/bin/dirsearch\nchmod +x /usr/local/bin/dirsearch\nchown -R vulpes:vulpes /opt/vulpkg/dirsearch 2>/dev/null || true"
}