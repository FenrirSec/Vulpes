{
  "name": "vulpes-browser",
  "version": "1.0",
  "description": "Pentest browser: renders web pages in a Vulpes window via curl (https ok), strips frame-blocking headers, and can route all browsing through an intercepting proxy on 8080/8083 (Burp/Caido), toggled from the toolbar. Binary from /shared/packages/.",
  "author": "Fenrir",
  "requires_sudo": true,
  "alpine_packages": [
    "curl",
    "ca-certificates"
  ],
  "install_script": "set -e\nSRC=/shared/packages/vulpes-browser\ntest -f \"$SRC\" || { echo \"[vulpes-browser] ERROR: $SRC not found. Put the vulpes-browser binary in /shared/packages/ first.\" >&2; exit 1; }\nfor pid in $(pgrep -f '/usr/local/bin/vulpes-browser' 2>/dev/null); do kill \"$pid\" 2>/dev/null || true; done\nsleep 1\ninstall -Dm755 \"$SRC\" /usr/local/bin/vulpes-browser\nmkdir -p /var/lib/vulpkg/startup\ncat > /var/lib/vulpkg/startup/vulpes-browser.sh <<'SH'\n#!/bin/bash\npgrep -f '/usr/local/bin/vulpes-browser' >/dev/null 2>&1 && exit 0\nexec /usr/local/bin/vulpes-browser\nSH\nchmod 755 /var/lib/vulpkg/startup/vulpes-browser.sh\n/usr/local/bin/vulpes-browser >/tmp/vulpes-browser.log 2>&1 </dev/null &\nsleep 1\necho '[vulpes-browser] installed from /shared/packages - running on 127.0.0.1:8899, open \"Browser\" from the launcher'\n",
  "files": {
    "/var/lib/vulpkg/applications/vulpes-browser.desktop": "[Desktop Entry]\nVersion=1.0\nType=Link\nName=Browser\nGenericName=Web Browser\nComment=Pentest browser - routes through Burp/Caido (8080/8083), renders in Vulpes\nURL=/port/8899/\nIcon=vulpes-browser\nCategories=Network;WebBrowser;\nKeywords=browser;web;proxy;burp;caido;\n",
    "/var/lib/vulpkg/icons/vulpes-browser.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 128 128\" width=\"128\" height=\"128\">\n  <rect width=\"128\" height=\"128\" rx=\"28\" fill=\"#1e1e2e\"/>\n  <rect x=\"22\" y=\"26\" width=\"84\" height=\"76\" rx=\"12\" fill=\"#313244\" stroke=\"#45475a\" stroke-width=\"2\"/>\n  <rect x=\"22\" y=\"26\" width=\"84\" height=\"20\" rx=\"12\" fill=\"#45475a\"/>\n  <circle cx=\"34\" cy=\"36\" r=\"3.2\" fill=\"#f38ba8\"/>\n  <circle cx=\"44\" cy=\"36\" r=\"3.2\" fill=\"#f9e2af\"/>\n  <circle cx=\"54\" cy=\"36\" r=\"3.2\" fill=\"#a6e3a1\"/>\n  <rect x=\"64\" y=\"32\" width=\"36\" height=\"8\" rx=\"4\" fill=\"#1e1e2e\"/>\n  <circle cx=\"64\" cy=\"74\" r=\"20\" fill=\"none\" stroke=\"#cba6f7\" stroke-width=\"3.5\"/>\n  <ellipse cx=\"64\" cy=\"74\" rx=\"9\" ry=\"20\" fill=\"none\" stroke=\"#cba6f7\" stroke-width=\"2.5\"/>\n  <line x1=\"44\" y1=\"74\" x2=\"84\" y2=\"74\" stroke=\"#cba6f7\" stroke-width=\"2.5\"/>\n  <line x1=\"47\" y1=\"64\" x2=\"81\" y2=\"64\" stroke=\"#89b4fa\" stroke-width=\"2\"/>\n  <line x1=\"47\" y1=\"84\" x2=\"81\" y2=\"84\" stroke=\"#89b4fa\" stroke-width=\"2\"/>\n</svg>\n"
  }
}
