{
  "name": "nuclei",
  "version": "latest",
  "description": "Template-based vulnerability scanner (ProjectDiscovery)",
  "author": "upstream",
  "requires_sudo": true,
  "alpine_packages": [
    "go"
  ],
  "install_script": "export GOROOT=/usr/lib/go GOBIN=/usr/local/bin GOPATH=/opt/vulpkg/.go GOFLAGS=-mod=mod GOTOOLCHAIN=auto\ngo install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest"
}