{
  "name": "gitleaks",
  "version": "latest",
  "description": "gitleaks - detect hardcoded secrets in git repos and files",
  "author": "gitleaks",
  "requires_sudo": true,
  "alpine_packages": [
    "go"
  ],
  "install_script": "export GOROOT=/usr/lib/go GOBIN=/usr/local/bin GOPATH=/opt/vulpkg/.go GOFLAGS=-mod=mod GOTOOLCHAIN=auto\ngo install github.com/zricethezav/gitleaks/v8@latest"
}